#!/bin/sh
set -eu

repository="$(git rev-parse --show-toplevel)"
cd "${repository}"

python_bin="python3"
if [ -x ".venv/bin/python" ]; then
  python_bin=".venv/bin/python"
fi

required=""
required="$(git config --local --get forecastloop.privateBoundaryRequired || true)"
if [ "${required}" = "true" ]; then
  "${python_bin}" scripts/audit_public_boundary.py \
    --repository . \
    --require-private-patterns
else
  "${python_bin}" scripts/audit_public_boundary.py --repository .
fi

exec "${python_bin}" scripts/audit_release_history.py \
  --repository . \
  --pre-push \
  --public-gate
