# Optional API-provider fallback only. File-based prediction and reflection
# tasks do not read these values or require an API key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Persistent API -> worker queue. A worker renews its lease while one attempt
# runs, never beyond the attempt fencing deadline, and retries only this many times.
FORECAST_LOOP_TASK_MAX_ATTEMPTS=3
FORECAST_LOOP_TASK_LEASE_SECONDS=60
FORECAST_LOOP_TASK_TIMEOUT_SECONDS=1800
FORECAST_LOOP_TASK_RETRY_DELAY_SECONDS=5

# Local application
VERICOUNCIL_DATABASE_URL=sqlite:///./data/vericouncil.sqlite3
VERICOUNCIL_CHECKPOINT_PATH=./data/checkpoints/langgraph.sqlite3
# Required by protected HTTP routes outside Demo mode. Generate at least 32
# random non-whitespace characters. Keep it server-side: never use VITE_*, a
# query parameter, browser storage, or a committed frontend configuration.
FORECAST_LOOP_OPERATOR_TOKEN=
VERICOUNCIL_HANDOFF_ROOT=./data/handoffs
# Private two-stage runtime jobs. This is not the top-level reflections/ archive.
VERICOUNCIL_REFLECTION_ROOT=./data/reflections
# Private sealed inputs. Top-level reflections/ and lessons/ are written only
# by the separate reflection-render command after finalize succeeds.
VERICOUNCIL_MARKET_SNAPSHOT_ROOT=./data/market-snapshots
# Immutable upstream-source prediction inputs.
VERICOUNCIL_EVIDENCE_SNAPSHOT_ROOT=./data/evidence-snapshots
# Immutable, hash-sealed daily preparation attempts exposed read-only to the UI.
VERICOUNCIL_PREDICTION_STATUS_ROOT=./data/prediction-status
# Private append-only User Judgment Wiki. It is not part of the published,
# citable framework Wiki mounted at ./wiki.
VERICOUNCIL_USER_JUDGMENT_WIKI_ROOT=./data/user-wiki
# Local human identity is server-owned; browsers cannot choose another actor.
VERICOUNCIL_USER_JUDGMENT_ACTOR_ID=local-operator
# A Live judgment must be sealed within this many minutes after committee
# completion and always before the target-session close.
VERICOUNCIL_USER_JUDGMENT_WINDOW_MINUTES=120
# Optional frontend dev/preview proxy override; keep the API on loopback.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional source-neutral executable adapters. Each adapter owns its provider
# credentials, paths, and field mapping outside this repository.
FORECAST_LOOP_EVIDENCE_SNAPSHOT_BUILDER=
FORECAST_LOOP_MARKET_OUTCOME_SNAPSHOT_BUILDER=
FORECAST_LOOP_SNAPSHOT_BUILDER_TIMEOUT_SECONDS=300
# Keep false until the first ten reflections pass manual review. The first 20
# independent Live target dates are all shadow-only: no weight adjustment or
# Wiki promotion, even if candidate Lesson generation is later enabled.
VERICOUNCIL_REFLECTION_LESSON_PROPOSALS_ENABLED=false
# These are lower safety bounds, not shortcuts: the Lesson gate queries
# immutable approved reviews and independent completed Live target dates.
VERICOUNCIL_REFLECTION_REQUIRED_HUMAN_REVIEWS=10
VERICOUNCIL_REFLECTION_SHADOW_TARGET_DATES=20
# Optional versioned prediction universe. When omitted, the legacy five-index
# A-share universe is used. Its IANA timezone must match VERICOUNCIL_TIMEZONE.
# Examples: ./examples/market-universes/us-index-and-equities.json
FORECAST_LOOP_MARKET_UNIVERSE_PATH=
VERICOUNCIL_TIMEZONE=Asia/Shanghai
# demo: offline UI/workflow test; api: FastAPI calls configured model;
# codex_file: Codex writes drafts.json and the CLI validates/finalizes it.
# These are safe local-development defaults. A private launchd API profile uses
# codex_file + demo=false and still binds the service to 127.0.0.1.
VERICOUNCIL_EXECUTION_PROVIDER=demo
VERICOUNCIL_DEMO_MODE=true
# Required for api live runs and manual `codex-prepare --mode live`. An external
# scheduled prepare builds a dated snapshot and injects its path into the
# one CLI handoff; the read-only codex_file API service does not keep this set.
# The JSON must freeze the base/target sessions, all configured instrument volatilities
# with trade-date-bound market provenance, an exchange-calendar source and
# sessions, timestamped evidence, and matching SHA-256 digests.
VERICOUNCIL_EVIDENCE_SNAPSHOT_PATH=
VERICOUNCIL_AUTO_SEED=true

# Optional LangSmith tracing. Core persistence never depends on LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=forecast-loop
